# Copy to .env.local and fill in. .env.local is gitignored — never commit real values.

# ── Supabase Postgres ────────────────────────────────────────────────────────
# Supabase → Project Settings → Database → Connection string.
#
# DATABASE_URL: use the *pooled* connection (port 6543, "Transaction" mode) —
# serverless functions open many short-lived connections and would otherwise
# exhaust the direct connection limit. Keep ?pgbouncer=true.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-1-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# DIRECT_URL: the *direct* connection (port 5432). Prisma Migrate needs this
# because migrations can't run through the pooler.
DIRECT_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres"

# ── Session signing ──────────────────────────────────────────────────────────
# Must be >= 32 chars. Generate one with:
#   node -e "console.log(crypto.randomUUID().replace(/-/g,'') + crypto.randomUUID().replace(/-/g,''))"
SESSION_SECRET="replace-me-with-64-hex-chars"

# ── Seed ─────────────────────────────────────────────────────────────────────
# Password given to the two demo accounts by `npm run db:seed`.
SEED_PASSWORD="choose-a-strong-password"

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins, no trailing slash.
# In development, localhost:3000-3002 are permitted automatically (proxy.ts).
# In production this list is the ONLY thing allowed — set your real domain:
#   ALLOWED_ORIGIN="https://shifa.vercel.app"
ALLOWED_ORIGIN="http://localhost:3000,http://localhost:3001"

# ── Cross-site cookies (production) ──────────────────────────────────────────
# Set to "true" ONLY when the frontend and API are on different domains
# (e.g. two separate Vercel projects). Required for the session cookie to be
# sent at all in that setup; leave unset for same-domain deploys.
# CROSS_SITE_COOKIE="true"
