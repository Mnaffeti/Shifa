// SHIFA — database schema.
//
// This mirrors the TypeScript interfaces that previously lived in the Vite
// app's React contexts (PatientContext, AppointmentContext, ChartContext,
// ConsultationContext, ReminderContext, AuthContext). Field names match the
// original interfaces so the API can serialize straight back to the shapes
// the frontend already expects.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum UserRole {
  DOCTOR
  /// Operator of the product, not clinical staff: sees demo visitor leads and
  /// no patient data.
  ADMIN
}

/// What an admin did. Stored as an enum rather than free text so the log can
/// be filtered reliably and a typo cannot invent a new action.
enum AuditAction {
  ADMIN_CREATED
  TRIAL_EXTENDED
  TRIAL_CONVERTED
  ADMIN_DELETED
  DOCTOR_CREATED
  DOCTOR_UPDATED
  DOCTOR_ACTIVATED
  DOCTOR_DEACTIVATED
  DOCTOR_DELETED
  DOCTOR_PASSWORD_RESET
  REQUEST_ACCEPTED
  REQUEST_REJECTED
}

enum DoctorRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum PatientStatus {
  Active
  New
  Inactive
}

enum AppointmentType {
  Consultation
  FollowUp   @map("Follow-up")
  Surgery
  Cancelled
}

enum AppointmentStatus {
  Pending
  Confirmed
  Cancelled
  Completed
}

enum ConsultationStatus {
  draft
  signed
}

enum AllergySeverity {
  mild
  moderate
  severe
}

enum AntecedentType {
  medical
  surgical
  familial
}

enum ProblemStatus {
  active
  resolved
}

enum AttachmentKind {
  scan
  photo
  document
}

// ─── Accounts (was: shifa_accounts / shifa_auth) ────────────────────────────

model Account {
  id           String   @id @default(cuid())
  /// Admins sign in with e-mail; doctors sign in with matricule instead, so
  /// this is optional now.
  email        String?  @unique
  /// Doctor's staff id, assigned by the back office. Their sign-in identifier
  /// in place of e-mail — never set for admins.
  matricule    String?  @unique
  /// bcrypt hash — never the plaintext password the old localStorage kept.
  passwordHash String
  name         String
  role         UserRole
  avatar       String
  specialty    String?
  phone        String?
  /// Set when the back office issues a temporary password. Forces the
  /// doctor to choose their own before they can use the rest of the app.
  mustChangePassword Boolean @default(false)
  /// Revocation switch. A deactivated account cannot sign in, and any session
  /// it already holds stops working on its next request — getSessionUser
  /// re-reads the row every time, so there is no cookie to wait out.
  isActive     Boolean  @default(true)
  /// Stamped on every successful sign-in. Lets the back office show real
  /// last-seen data from Account itself rather than from the best-effort
  /// DemoLead log, which is written outside the account transaction.
  lastLoginAt  DateTime?
  /// Successful sign-ins, counted on the account itself so the figure cannot
  /// drift away from the account it describes.
  loginCount   Int      @default(0)
  /// End of the free trial. Null means unlimited access — admins, and doctor
  /// accounts converted to a paid plan.
  ///
  /// Set at account creation, not at first sign-in: the back office needs a
  /// predictable end date it can plan around. Once past, the account can no
  /// longer sign in; an admin extends or converts it from the Médecins page.
  trialEndsAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  patients      Patient[]
  appointments  Appointment[]
  consultations Consultation[]
  reminders     Reminder[]

  @@map("accounts")
}

// ─── Patients (was: shifa_patients_v2) ──────────────────────────────────────

model Patient {
  /// Human-readable business id, e.g. "PT-001" — kept as the primary key so
  /// existing appointment/chart references stay valid after migration.
  id              String        @id
  firstName       String
  lastName        String
  dob             String
  gender          String
  phone           String
  email           String
  address         String
  profession      String
  cin             String
  parentFirstName String?
  parentLastName  String?
  parentComments  String?
  /// Display label only — what the UI prints. Authorization and counting use
  /// doctorId, so renaming a doctor no longer detaches their records.
  assignedDoctor  String
  /// Owning clinician. Nullable only to allow the backfill migration; every
  /// row created through the API carries it.
  doctorId        String?
  bloodType       String
  status          PatientStatus @default(New)
  /// "Never" in the old model is represented as null here.
  lastVisit       String?
  avatar          String
  createdAt       String
  updatedAt       DateTime      @updatedAt

  doctor        Account?       @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  appointments  Appointment[]
  consultations Consultation[]
  chart         Chart?

  @@index([doctorId])
  @@index([assignedDoctor])
  @@index([status])
  @@map("patients")
}

// ─── Appointments (was: shifa_appointments_v2) ──────────────────────────────

model Appointment {
  id          String            @id @default(cuid())
  patientId   String
  patientName String
  /// Display label only; doctorId is the real owner. See Patient.assignedDoctor.
  doctor      String
  doctorId    String?
  /// yyyy-MM-dd wall-clock clinic day.
  date        String
  /// "HH:MM" wall-clock times, not timezone-shifted.
  startTime   String
  endTime     String
  duration    Int?
  type        AppointmentType
  status      AppointmentStatus @default(Pending)
  notes       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  patient       Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorAccount Account?       @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  consultations Consultation[]

  @@index([patientId])
  @@index([doctorId, date])
  @@index([doctor, date])
  @@index([date, status])
  @@map("appointments")
}

// ─── Patient chart (was: shifa_charts_v2) ───────────────────────────────────

model Chart {
  patientId String   @id
  updatedAt DateTime @updatedAt

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  allergies      Allergy[]
  antecedents    Antecedent[]
  problemesActifs ActiveProblem[]
  traitements    ChronicTreatment[]
  alertes        MedicalAlert[]
  notes          ClinicalNote[]
  attachments    Attachment[]
  /// Latest vitals snapshot (was `dernieresConstantes`).
  vitals         Vitals?

  @@map("charts")
}

model Allergy {
  id        String          @id @default(cuid())
  chartId   String
  substance String
  severity  AllergySeverity
  reaction  String

  chart Chart @relation(fields: [chartId], references: [patientId], onDelete: Cascade)

  @@index([chartId])
  @@map("allergies")
}

model Antecedent {
  id          String         @id @default(cuid())
  chartId     String
  type        AntecedentType
  description String
  date        String?

  chart Chart @relation(fields: [chartId], references: [patientId], onDelete: Cascade)

  @@index([chartId])
  @@map("antecedents")
}

model ActiveProblem {
  id        String        @id @default(cuid())
  chartId   String
  cimCode   String?
  label     String
  dateOnset String
  status    ProblemStatus @default(active)

  chart Chart @relation(fields: [chartId], references: [patientId], onDelete: Cascade)

  @@index([chartId])
  @@map("active_problems")
}

model ChronicTreatment {
  id        String @id @default(cuid())
  chartId   String
  name      String
  dosage    String
  frequency String
  since     String

  chart Chart @relation(fields: [chartId], references: [patientId], onDelete: Cascade)

  @@index([chartId])
  @@map("chronic_treatments")
}

model MedicalAlert {
  id      String @id @default(cuid())
  chartId String
  label   String

  chart Chart @relation(fields: [chartId], references: [patientId], onDelete: Cascade)

  @@index([chartId])
  @@map("medical_alerts")
}

model ClinicalNote {
  id        String   @id @default(cuid())
  chartId   String
  text      String
  author    String
  createdAt DateTime @default(now())

  chart Chart @relation(fields: [chartId], references: [patientId], onDelete: Cascade)

  @@index([chartId])
  @@map("clinical_notes")
}

model Attachment {
  id       String         @id @default(cuid())
  chartId  String
  name     String
  kind     AttachmentKind
  mimeType String
  /// base64 data URL, as in the original model. Large payloads — the API
  /// omits this field from list responses and serves it only on demand.
  dataUrl  String
  addedAt  DateTime       @default(now())
  addedBy  String

  chart Chart @relation(fields: [chartId], references: [patientId], onDelete: Cascade)

  @@index([chartId])
  @@map("attachments")
}

/// Vitals attach either to a chart (latest snapshot) or to a consultation
/// (the reading taken during that visit).
model Vitals {
  id             String  @id @default(cuid())
  chartId        String? @unique
  consultationId String? @unique
  date           String
  weight         Float?
  height         Float?
  bp             String?
  hr             Int?
  temp           Float?
  spo2           Int?

  chart        Chart?        @relation(fields: [chartId], references: [patientId], onDelete: Cascade)
  consultation Consultation? @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  @@map("vitals")
}

// ─── Consultations (was: shifa_consultations) ───────────────────────────────

model Consultation {
  id            String             @id @default(cuid())
  patientId     String
  appointmentId String?
  date          String
  /// Display label only; doctorId is the real owner. Kept verbatim on a signed
  /// consultation, which is a legal record of who signed it.
  doctor        String
  doctorId      String?
  /// SOAP note, flattened from the nested `soap` object.
  subjectif     String             @default("")
  objectif      String             @default("")
  assessment    String             @default("")
  plan          String             @default("")
  diagnoses     String[]           @default([])
  /// Ordonnance metadata; the line items live in OrdonnanceItem.
  renewedFromId String?
  templateName  String?
  status        ConsultationStatus @default(draft)
  signedAt      DateTime?
  signedBy      String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  patient     Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorAccount Account?       @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  appointment Appointment?     @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  ordonnance  OrdonnanceItem[]
  addenda     Addendum[]
  constantes  Vitals?

  @@index([patientId])
  @@index([appointmentId])
  @@index([doctorId, date])
  @@index([doctor, date])
  @@map("consultations")
}

model OrdonnanceItem {
  id             String  @id @default(cuid())
  consultationId String
  medication     String
  dosage         String
  frequency      String
  duration       String
  instructions   String?
  /// Preserves the clinician's ordering within the prescription.
  position       Int     @default(0)

  consultation Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  @@index([consultationId])
  @@map("ordonnance_items")
}

model Addendum {
  id             String   @id @default(cuid())
  consultationId String
  text           String
  addedBy        String
  addedAt        DateTime @default(now())

  consultation Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  @@index([consultationId])
  @@map("addenda")
}

// ─── Reminders (was: shifa_reminders) ───────────────────────────────────────

/// A clinician's private memo board. Scoped to its author: `authorName` is a
/// display label, `authorId` is what every read and write is filtered by.
model Reminder {
  id         String   @id @default(cuid())
  text       String
  dueTime    String?
  authorRole UserRole
  authorName String
  /// Owning account. Nullable only to allow the backfill migration; every
  /// reminder created through the API carries it.
  authorId   String?
  done       Boolean  @default(false)
  createdAt  DateTime @default(now())

  author Account? @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([authorId, done])
  @@index([done])
  @@map("reminders")
}

// ─── Waitlist (was: WaitlistModal localStorage store) ───────────────────────

/// Append-only record of every back-office action on an account.
///
/// Deliberately denormalised: actorName and targetLabel are copied in at write
/// time rather than joined at read time. An audit entry must still read
/// correctly after the account it refers to is renamed or deleted — a log that
/// changes retroactively is not an audit trail.
///
/// Never updated or deleted by the application.
model AuditLog {
  id         String      @id @default(cuid())
  action     AuditAction
  /// Who performed it. Null if that admin account was later removed.
  actorId    String?
  /// Their name at the time of the action.
  actorName  String
  /// The account acted upon, when the action targets one.
  targetId   String?
  /// Its identifying label at the time, e.g. "Dr. Youssef (DOC-0001)".
  targetLabel String
  /// Human-readable specifics, e.g. which fields changed. Never a password.
  details    String?
  createdAt  DateTime    @default(now())

  @@index([createdAt])
  @@index([actorId])
  @@index([targetId])
  @@map("audit_logs")
}

/// DEPRECATED — no longer read or written by the application.
///
/// It logged registrations and sign-in counts, but was updated outside the
/// account transaction, so it drifted: accounts existed with no lead row, and
/// the back office showed an empty activity list for doctors signing in daily.
/// Account.lastLoginAt and Account.loginCount replaced it.
///
/// The table is kept for now so existing history is not destroyed; drop it once
/// you have confirmed nothing needs that history.
model DemoLead {
  id          String   @id @default(cuid())
  name        String
  phone       String
  specialty   String?
  email       String?
  accountId   String?
  createdAt   DateTime @default(now())
  /// Bumped on every successful sign-in.
  lastSeenAt  DateTime @updatedAt
  visits      Int      @default(1)

  @@unique([name, phone])
  @@index([createdAt])
  @@map("demo_leads")
}

model WaitlistEntry {
  id        String   @id @default(cuid())
  name      String
  phone     String
  reason    String?
  createdAt DateTime @default(now())

  @@unique([name, phone])
  @@map("waitlist_entries")
}

// ─── Doctor account requests ────────────────────────────────────────────────

/// A doctor's public request for an account. No password is collected here —
/// an admin reviews it in the back office and, on acceptance, the server
/// creates the Account and issues a temporary password.
model DoctorRequest {
  id        String              @id @default(cuid())
  name      String
  matricule String
  specialty String
  phone     String
  status    DoctorRequestStatus @default(PENDING)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@map("doctor_requests")
}
